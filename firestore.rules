rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for Role-Based Access Control (RBAC)
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function userDocExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isValidRole(role) {
      return role in ['DONOR', 'PATIENT_FAMILY', 'VOLUNTEER', 'ADMIN', 'DOCTOR', 'HOSPITAL', 'CSR'];
    }

    // Phase 2: Role Lookup - reads from users/{uid}.
    // If unauthenticated, doc missing, or role missing/invalid, safely returns 'UNASSIGNED'.
    // NEVER defaults to DONOR, ADMIN, DOCTOR or any privileged role.
    function getUserRole() {
      return (userDocExists() && ('role' in getUserDoc()) && isValidRole(getUserDoc().role))
        ? getUserDoc().role
        : 'UNASSIGNED';
    }

    function hasRole(role) {
      return isAuthenticated() && getUserRole() == role;
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isDoctor() {
      return hasRole('DOCTOR');
    }

    function isHospital() {
      return hasRole('HOSPITAL');
    }

    function isCSR() {
      return hasRole('CSR');
    }

    function isPatientFamily() {
      return hasRole('PATIENT_FAMILY');
    }

    function isVolunteer() {
      return hasRole('VOLUNTEER');
    }

    function isDonor() {
      return hasRole('DONOR');
    }

    // 1. USERS COLLECTION: Self read/update, Admin full access. Prevent role self-elevation.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Public self-registration permits only DONOR, PATIENT_FAMILY, VOLUNTEER.
      // Document ID and embedded UID must match the authenticated UID.
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        (request.resource.data.role in ['DONOR', 'PATIENT_FAMILY', 'VOLUNTEER']) &&
        request.resource.data.keys().hasAll(['uid', 'email', 'role']);

      // Profile updates: Non-admin users cannot alter role or UID, only permitted profile fields.
      allow update: if (
        (isOwner(userId) &&
         request.resource.data.uid == resource.data.uid &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'displayName', 'consentGiven', 'phone', 'city', 'state', 'updatedAt', 'email'
         ])) ||
        isAdmin()
      );

      allow delete: if isOwner(userId) || isAdmin();
    }

    // 2. PATIENT APPLICATIONS COLLECTION (STRICT PRIVATE INTAKE)
    match /patientApplications/{applicationId} {
      // Read: Patient owner, Admin, or explicitly assigned Doctor/Hospital
      allow read: if isAuthenticated() && (
        isOwner(resource.data.userId) ||
        isAdmin() ||
        (isDoctor() && ('assignedDoctorId' in resource.data) && resource.data.assignedDoctorId == request.auth.uid) ||
        (isHospital() && ('assignedHospitalId' in resource.data) && resource.data.assignedHospitalId == request.auth.uid)
      );

      // Create: Authenticated PATIENT_FAMILY creating their own application in SUBMITTED status (or Admin)
      allow create: if isAuthenticated() && (
        (isPatientFamily() &&
         request.resource.data.userId == request.auth.uid &&
         request.resource.data.status == 'SUBMITTED' &&
         request.resource.data.keys().hasAll(['userId', 'patientName', 'diseaseCategory', 'status', 'createdAt'])) ||
        isAdmin()
      );

      // Update:
      // - Patient family can only update their own application while still in 'SUBMITTED' status (e.g. edit draft),
      //   and CANNOT change userId or self-approve/change status
      // - Admin can review and update status and verification records
      // - Assigned Doctor / Hospital can update verification notes if assigned
      allow update: if isAuthenticated() && (
        (isOwner(resource.data.userId) &&
         resource.data.status == 'SUBMITTED' &&
         request.resource.data.userId == resource.data.userId &&
         request.resource.data.status == 'SUBMITTED' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly([
           'patientName', 'age', 'city', 'state', 'diseaseCategory',
           'targetAmount', 'treatingHospital', 'attendingDoctor',
           'summary', 'documentFileName', 'milestones'
         ])) ||
        (isAdmin() &&
         request.resource.data.userId == resource.data.userId &&
         (request.resource.data.status in ['SUBMITTED', 'UNDER_REVIEW', 'VERIFIED', 'APPROVED', 'REJECTED'])) ||
        (isDoctor() &&
         ('assignedDoctorId' in resource.data) &&
         resource.data.assignedDoctorId == request.auth.uid &&
         request.resource.data.userId == resource.data.userId) ||
        (isHospital() &&
         ('assignedHospitalId' in resource.data) &&
         resource.data.assignedHospitalId == request.auth.uid &&
         request.resource.data.userId == resource.data.userId)
      );

      // Delete: Admin only
      allow delete: if isAdmin();
    }

    // 3. PATIENTS & CAMPAIGNS COLLECTIONS: Public read (approved/sanitized), Admin/Doctor/Hospital manage
    // Private unverified applications are NEVER stored here.
    match /patients/{patientId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if (isDoctor() || isHospital() || isAdmin()) && (!('raisedAmount' in request.resource.data) || request.resource.data.raisedAmount == resource.data.raisedAmount || isAdmin());
      allow delete: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    // 4. VERIFICATION & HOPE JOURNEY: Public read checklist status, Doctor / Hospital / Admin write
    match /verification/{verificationId} {
      allow read: if true;
      allow create, update: if isDoctor() || isHospital() || isAdmin();
      allow delete: if isAdmin();
    }

    match /hopeJourney/{journeyId} {
      allow read: if true;
      allow create, update: if isPatientFamily() || isDoctor() || isHospital() || isAdmin();
      allow delete: if isAdmin();
    }

    // 5. HOSPITALS & DOCTORS DIRECTORY: Public read, Doctor / Hospital / Admin update
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow create, update: if isHospital() || isAdmin();
    }

    match /doctors/{doctorId} {
      allow read: if true;
      allow create, update: if isDoctor() || isAdmin();
    }

    // 6. BLOOD DONORS & REQUESTS: Authenticated read donors, Public read requests
    match /bloodDonors/{donorId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid);
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /bloodRequests/{requestId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isHospital() || isAdmin();
    }

    // 7. VOLUNTEERS & DONATIONS: Audit trail & Demo mode tracking
    match /volunteers/{volunteerId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /donations/{donationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }

    match /transparency/{ledgerId} {
      allow read: if true;
      allow create, update: if isAdmin();
    }

    // 8. AUDIT LOGS COLLECTION: Immutable records created on important administrative/verification actions
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isDoctor() || isHospital();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }

    // 9. RESEARCH & NOTIFICATIONS
    match /research/{paperId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isOwner(resource.data.recipientUid);
      allow create: if isAuthenticated();
      allow update: if isOwner(resource.data.recipientUid);
    }

    // 10. PILOT OPERATIONS CENTER COLLECTIONS (V1.1)
    match /pilotParticipants/{participantId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /pilotFeedback/{feedbackId} {
      allow read: if isOwner(resource.data.userId) || isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /pilotIssues/{issueId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
